# ===== Dependências e build =====
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# ===== Vercel e Supabase (arquivos locais das CLIs) =====
.vercel/
supabase/.temp/
supabase/.branches/

# ===== Segredos =====
# Nenhum .env sobe; se um dia precisar de modelo, use .env.example.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credenciais*.json
*service-account*.json

# ===== Planilhas e documentos de referência =====
# São material de consulta, não código (a planilha de materiais já subiu uma
# vez por engano). O que o painel lê fica em dados/*.json.
*.xlsx
*.xls
*.xlsm
*.csv
*.docx
*.pdf
~$*

# ===== Logs e depuração =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Testes e cobertura =====
coverage/
.nyc_output/

# ===== Caches =====
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/

# ===== Editores =====
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-workspace

# ===== Sistema operacional =====
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ===== Temporários =====
*.tmp
*.bak
*.orig
tmp/
temp/
